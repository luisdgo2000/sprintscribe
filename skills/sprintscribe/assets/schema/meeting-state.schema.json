{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://sprintscribe.local/schema/meeting-state.schema.json",
  "title": "SprintScribe meeting state",
  "description": "Estado reconciliado de una reunion. Es la unica salida que escribe el modelo; los documentos Markdown se renderizan a partir de este archivo.",
  "type": "object",
  "required": ["schema_version", "meeting", "projects", "tasks", "decisions", "reconciliation_log"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"type": "string", "enum": ["1.0"]},
    "meeting": {"$ref": "#/definitions/meeting"},
    "projects": {"type": "array", "items": {"$ref": "#/definitions/project"}},
    "tasks": {"type": "array", "items": {"$ref": "#/definitions/task"}},
    "decisions": {"type": "array", "items": {"$ref": "#/definitions/decision"}},
    "contradictions": {"type": "array", "items": {"$ref": "#/definitions/contradiction"}},
    "open_questions": {"type": "array", "items": {"$ref": "#/definitions/open_question"}},
    "reconciliation_log": {"type": "array", "items": {"$ref": "#/definitions/reconciliation_entry"}},
    "ops_plan": {"type": "array", "items": {"$ref": "#/definitions/operation"}},
    "notes": {"type": "array", "items": {"type": "string"}}
  },
  "definitions": {
    "certainty": {
      "type": "string",
      "enum": ["explicit", "inferred", "recommended", "pending"],
      "description": "explicit = confirmado explicitamente; inferred = inferido con respaldo contextual; recommended = recomendado por SprintScribe; pending = pendiente de confirmacion."
    },
    "level": {"type": "string", "enum": ["low", "medium", "high"]},
    "person": {"type": ["string", "null"], "description": "Nombre canonico de la persona tal como aparece en el roster o en los participantes."},
    "evidence": {
      "type": "object",
      "required": ["quote"],
      "additionalProperties": false,
      "properties": {
        "quote": {"type": "string", "minLength": 1, "description": "Cita breve o parafrasis fiel del fragmento que sustenta el elemento."},
        "speaker": {"type": ["string", "null"]},
        "timestamp": {"type": ["string", "null"]},
        "meeting_id": {"type": ["string", "null"]}
      }
    },
    "meeting": {
      "type": "object",
      "required": ["id", "type", "participants"],
      "additionalProperties": false,
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
        "date": {"type": ["string", "null"], "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
        "type": {"type": "string", "enum": ["refinement", "planning", "follow_up", "review", "other"]},
        "sprint": {"type": ["string", "null"]},
        "title": {"type": ["string", "null"]},
        "source": {"type": ["string", "null"], "description": "Ruta o nombre del insumo procesado."},
        "previous_meetings": {"type": "array", "items": {"type": "string"}},
        "participants": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "identity_confidence"],
            "additionalProperties": false,
            "properties": {
              "name": {"type": "string", "minLength": 1},
              "speaker_labels": {"type": "array", "items": {"type": "string"}},
              "role": {"type": ["string", "null"]},
              "identity_confidence": {"$ref": "#/definitions/level"}
            }
          }
        }
      }
    },
    "project": {
      "type": "object",
      "required": ["id", "key", "name", "status"],
      "additionalProperties": false,
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$", "description": "Slug estable; tambien es el nombre de la carpeta de documentacion."},
        "key": {"type": "string", "pattern": "^[A-Z][A-Z0-9]{1,9}$", "description": "Prefijo de los IDs de tarea del proyecto (KEY-T1)."},
        "name": {"type": "string", "minLength": 1},
        "aliases": {"type": "array", "items": {"type": "string"}},
        "status": {"type": "string", "enum": ["confirmed", "pending_confirmation"]},
        "resolution_basis": {"type": ["string", "null"], "description": "Como se identifico el proyecto (nombre explicito, alias, documentacion, relacion semantica)."},
        "sprint_objective": {"$ref": "#/definitions/sprint_objective"},
        "roadmap": {"type": "array", "items": {"$ref": "#/definitions/roadmap_step"}}
      }
    },
    "sprint_objective": {
      "type": "object",
      "required": ["statement", "certainty"],
      "additionalProperties": false,
      "properties": {
        "statement": {"type": "string", "minLength": 1},
        "certainty": {"$ref": "#/definitions/certainty"},
        "expected_result": {"type": ["string", "null"]},
        "business_need": {"type": ["string", "null"]},
        "deliverables": {"type": "array", "items": {"type": "string"}},
        "owners": {"type": "array", "items": {"type": "string"}},
        "participants": {"type": "array", "items": {"type": "string"}},
        "scope": {"type": "array", "items": {"type": "string"}},
        "exclusions": {"type": "array", "items": {"type": "string"}},
        "period": {"type": ["string", "null"]},
        "candidates": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["statement", "support"],
            "additionalProperties": false,
            "properties": {
              "statement": {"type": "string"},
              "support": {"type": "string"}
            }
          }
        }
      }
    },
    "roadmap_step": {
      "type": "object",
      "required": ["order", "step", "purpose", "kind", "duration"],
      "additionalProperties": false,
      "properties": {
        "order": {"type": "integer"},
        "step": {"type": "string", "minLength": 1},
        "purpose": {"type": "string", "minLength": 1},
        "kind": {"type": "string", "enum": ["agreed", "recommended"]},
        "owner": {"$ref": "#/definitions/person"},
        "task_refs": {"type": "array", "items": {"type": "string"}},
        "depends_on": {"type": "array", "items": {"type": "integer"}, "description": "Numeros de orden de otros pasos."},
        "duration": {
          "type": "object",
          "required": ["range", "basis"],
          "additionalProperties": false,
          "properties": {
            "range": {"type": "string", "minLength": 1},
            "basis": {"type": "string", "minLength": 1},
            "confidence": {"$ref": "#/definitions/level"}
          }
        },
        "risks": {"type": "array", "items": {"type": "string"}}
      }
    },
    "effort": {
      "type": "object",
      "required": ["range", "level", "confidence", "rationale"],
      "additionalProperties": false,
      "properties": {
        "range": {"type": "string", "minLength": 1, "description": "Rango temporal de esfuerzo de UNA tarea, p. ej. '4-8 h' o '1-2 d'."},
        "level": {"$ref": "#/definitions/level"},
        "confidence": {"$ref": "#/definitions/level"},
        "rationale": {"type": "string", "minLength": 1},
        "native_value": {"type": ["number", "null"], "description": "Solo si la convencion del equipo esta identificada en la configuracion."}
      }
    },
    "task": {
      "type": "object",
      "required": ["id", "project_id", "title", "status", "certainty", "evidence"],
      "additionalProperties": false,
      "properties": {
        "id": {"type": "string", "pattern": "^[A-Z][A-Z0-9]{1,9}-T\\d+$"},
        "project_id": {"type": "string", "minLength": 1, "description": "id del proyecto o PENDING."},
        "related_projects": {"type": "array", "items": {"type": "string"}},
        "title": {"type": "string", "minLength": 1},
        "description": {"type": ["string", "null"]},
        "acceptance_criterion": {"type": ["string", "null"], "description": "Exactamente UN criterio de aceptacion verificable."},
        "status": {
          "type": "string",
          "enum": ["proposed", "confirmed", "modified", "cancelled", "blocked", "deferred", "needs_clarification", "completed"]
        },
        "certainty": {"$ref": "#/definitions/certainty"},
        "work_item_type": {"type": ["string", "null"], "description": "Tipo logico (task, story, bug, research...). El tipo real lo resuelve el perfil de Boards."},
        "proposed_by": {"$ref": "#/definitions/person"},
        "decided_by": {"$ref": "#/definitions/person"},
        "owner": {"$ref": "#/definitions/person"},
        "owner_certainty": {"$ref": "#/definitions/certainty"},
        "priority": {"type": ["integer", "string", "null"]},
        "priority_certainty": {"$ref": "#/definitions/certainty"},
        "effort": {"$ref": "#/definitions/effort"},
        "depends_on": {"type": "array", "items": {"type": "string"}},
        "blocked_by": {"type": ["string", "null"]},
        "relations": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "supersedes": {"type": "array", "items": {"type": "string"}},
            "superseded_by": {"type": ["string", "null"]},
            "split_from": {"type": ["string", "null"]},
            "merged_into": {"type": ["string", "null"]}
          }
        },
        "hierarchy_hint": {
          "type": "object",
          "additionalProperties": false,
          "description": "Pistas en texto para resolver contra los catalogos del Excel o de Boards. Nunca IDs inventados.",
          "properties": {
            "use_case": {"type": ["string", "null"]},
            "epic": {"type": ["string", "null"]},
            "feature": {"type": ["string", "null"]},
            "story": {"type": ["string", "null"]}
          }
        },
        "evidence": {"type": "array", "minItems": 1, "items": {"$ref": "#/definitions/evidence"}},
        "boards": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "work_item_id": {"type": ["integer", "null"]},
            "state": {"type": ["string", "null"]},
            "match_confidence": {"type": ["string", "null"], "enum": ["verified", "high", "medium", "low", null]}
          }
        },
        "history": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["change"],
            "additionalProperties": false,
            "properties": {
              "meeting_id": {"type": ["string", "null"]},
              "change": {"type": "string"},
              "reason": {"type": ["string", "null"]}
            }
          }
        }
      }
    },
    "decision": {
      "type": "object",
      "required": ["id", "kind", "text", "status"],
      "additionalProperties": false,
      "properties": {
        "id": {"type": "string", "pattern": "^D\\d+$"},
        "project_id": {"type": ["string", "null"]},
        "kind": {
          "type": "string",
          "enum": ["decision", "change", "responsibility", "commitment", "dependency", "blocker", "risk", "open_question", "po_validation", "external_action"]
        },
        "text": {"type": "string", "minLength": 1},
        "context": {"type": ["string", "null"], "description": "Por que importa y que impacto tiene."},
        "decided_by": {"$ref": "#/definitions/person"},
        "executed_by": {"$ref": "#/definitions/person"},
        "status": {"type": "string", "enum": ["confirmed", "pending", "discarded", "superseded"]},
        "certainty": {"$ref": "#/definitions/certainty"},
        "task_refs": {"type": "array", "items": {"type": "string"}},
        "supersedes": {"type": ["string", "null"]},
        "evidence": {"type": "array", "items": {"$ref": "#/definitions/evidence"}}
      }
    },
    "contradiction": {
      "type": "object",
      "required": ["id", "text", "statements"],
      "additionalProperties": false,
      "properties": {
        "id": {"type": "string", "pattern": "^C\\d+$"},
        "text": {"type": "string"},
        "task_refs": {"type": "array", "items": {"type": "string"}},
        "blocking": {"type": "boolean", "description": "true (por defecto) = impide confirmar las tareas afectadas hasta resolverla."},
        "statements": {"type": "array", "minItems": 2, "items": {"$ref": "#/definitions/evidence"}},
        "resolution": {"type": ["string", "null"]}
      }
    },
    "open_question": {
      "type": "object",
      "required": ["id", "question"],
      "additionalProperties": false,
      "properties": {
        "id": {"type": "string", "pattern": "^Q\\d+$"},
        "project_id": {"type": ["string", "null"]},
        "question": {"type": "string", "minLength": 1},
        "blocks": {"type": "array", "items": {"type": "string"}},
        "ask": {"$ref": "#/definitions/person"}
      }
    },
    "reconciliation_entry": {
      "type": "object",
      "required": ["id", "action", "task_ref", "reason"],
      "additionalProperties": false,
      "properties": {
        "id": {"type": "string", "pattern": "^R\\d+$"},
        "action": {
          "type": "string",
          "enum": ["added", "modified", "superseded", "cancelled", "reassigned", "split", "merged", "deferred", "blocked", "completed", "reopened", "project_changed"]
        },
        "task_ref": {"type": "string"},
        "from": {"type": ["string", "null"]},
        "to": {"type": ["string", "null"]},
        "reason": {"type": "string", "minLength": 1},
        "cause_decision": {"type": ["string", "null"]},
        "meeting_id": {"type": ["string", "null"]},
        "evidence": {"type": "array", "items": {"$ref": "#/definitions/evidence"}}
      }
    },
    "operation": {
      "type": "object",
      "required": ["op", "task_ref", "status", "reason"],
      "additionalProperties": false,
      "properties": {
        "op": {"type": "string", "enum": ["create", "update", "change_state", "link", "noop", "hold", "skip", "needs_review"]},
        "task_ref": {"type": "string"},
        "work_item_id": {"type": ["integer", "null"]},
        "target_state": {"type": ["string", "null"]},
        "fields": {"type": "object"},
        "candidates": {"type": "array", "items": {"type": "object"}},
        "status": {"type": "string", "enum": ["pending", "applied", "failed", "needs_review"]},
        "reason": {"type": "string"},
        "result": {"type": ["object", "null"], "description": "Respuesta real de la herramienta externa. Obligatorio si status = applied o failed."}
      }
    }
  }
}
